type Query {
    repositoryProvider: String!
    technicians: [TechnicianAccount!]!

    bikes: [Bike!]!
    bikeById(bikeId: ID!): Bike

    maintenanceIssues: [MaintenanceIssue!]!
    myMaintenanceIssues: [MaintenanceIssue!]!

    maintenanceIssueById(
        maintenanceIssueId: ID!
    ): MaintenanceIssue

    maintenanceIssuesByBikeId(
        bikeId: ID!
    ): [MaintenanceIssue!]!

    workOrders: [WorkOrder!]!
    myWorkOrders: [WorkOrder!]!

    workOrderById(
        workOrderId: ID!
    ): WorkOrder

    workOrdersByBikeId(
        bikeId: ID!
    ): [WorkOrder!]!
}

type Mutation {
    createBike(
        input: CreateBikeInput!
    ): Bike!

    updateBike(
        input: BikeInput!
    ): Bike!

    createMaintenanceIssue(
        input: MaintenanceIssueInput!
    ): MaintenanceIssue!

    resolveMaintenanceIssue(
        maintenanceIssueId: ID!
    ): MaintenanceIssue!

    createWorkOrder(
        input: WorkOrderInput!
    ): WorkOrder!

    startWork(
        workOrderId: ID!
    ): WorkOrder!

    closeWorkOrder(
        input: CloseWorkOrderInput!
    ): WorkOrder!
}

type Bike {
    bikeId: ID!
    model: String!
    condition: String!
    rideCount: Int!
    mileage: Float!
}

type MaintenanceIssue {
    maintenanceIssueId: ID!
    bikeId: ID!
    reportedByUserId: ID
    sourceType: String!
    description: String!
    severity: String!
    status: String!
    reportedDate: String!
}

type WorkOrder {
    workOrderId: ID!
    bikeId: ID!
    maintenanceIssueId: ID!
    description: String!
    assignedTechnicianId: ID
    status: String!
    createdDate: String!
}

type TechnicianAccount {
    userId: ID!
    displayName: String!
    email: String!
}

input CreateBikeInput {
    model: String!
    condition: String!
    rideCount: Int!
    mileage: Float!
}

input BikeInput {
    bikeId: ID!
    model: String!
    condition: String!
    rideCount: Int!
    mileage: Float!
}

input MaintenanceIssueInput {
    bikeId: ID!
    sourceType: String!
    description: String!
    severity: String!
}

input WorkOrderInput {
    bikeId: ID!
    maintenanceIssueId: ID!
    description: String!
    assignedTechnicianId: ID
}

input CloseWorkOrderInput {
    workOrderId: ID!
    resultingBikeCondition: String!
}
