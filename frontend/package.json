{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bdd": "cucumber-js --config cucumber.cjs",
    "bdd:smoke": "cucumber-js --config cucumber.cjs --tags \"@smoke and not @graphql-provider\"",
    "bdd:smoke:graphql": "cucumber-js --config cucumber.cjs --tags \"@smoke and @graphql-provider\""
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "vite": "^8.1.1"
  }
}
